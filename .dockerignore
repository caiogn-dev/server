# ============================================================================
# DOCKER IGNORE FILE
# ============================================================================
# Files and directories to exclude from Docker build context
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment variables
.env
.env.local
.env.*.local

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md
!README.md
DEPLOY.md

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Railway
railway.toml

# Backup files
*.bak
*.backup
backups/

# Logs
logs/
*.log

# Node (if using any JS tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.pid
*.seed
*.pid.lock

# Scripts de teste manual da raiz. Os Dockerfiles fazem `COPY . .`, então
# qualquer script solto aqui entra na imagem de produção — foi assim que um
# client_secret da Uber acabou legível por `docker exec` no container.
# Os testes de verdade vivem em apps/*/tests/ e tests/, que não casam com isto.
/test_*.py
/*_test.py
/mcp_*.py

# Clone git aninhado (1.4M, com .git próprio). O padrão `.git/` acima só casa
# na raiz do contexto, então openapi/.git iria inteiro para a imagem.
openapi/
